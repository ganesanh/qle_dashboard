NODE_ENV=development
APP_ENV=local
PORT=8787
STORAGE_DIR=./storage
BUNDLES_DIR=./storage/bundles
FORMATTED_OUTPUT_DIR=./storage/formatted
ENABLE_DEVELOPER_FLOW=false
DEVELOPER_REPO_PATH=
DEVELOPER_SKILL_PATH=
DEVELOPER_SPA_RELATIVE_PATH=ghix-web/src/main/webapp/resources/spa
CURSOR_AGENT_BIN=cursor-agent
CURSOR_RUN_TIMEOUT_MS=1200000

DB_HOST=replace_with_database_host
DB_PORT=5432
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
DB_SCHEMA=public
DB_SSL=false

# OAuth app secrets live in Railway variables, not in source control.
APP_BASE_URL=http://localhost:8787
SESSION_SECRET=replace_with_long_random_session_secret
OAUTH_TOKEN_ENCRYPTION_KEY=replace_with_long_random_token_encryption_key
ATLASSIAN_CLIENT_ID=replace_with_atlassian_oauth_client_id
ATLASSIAN_CLIENT_SECRET=replace_with_atlassian_oauth_client_secret
ATLASSIAN_REDIRECT_URI=http://localhost:8787/api/oauth/atlassian/callback
BITBUCKET_CLIENT_ID=replace_with_bitbucket_oauth_client_id
BITBUCKET_CLIENT_SECRET=replace_with_bitbucket_oauth_client_secret
BITBUCKET_REDIRECT_URI=http://localhost:8787/api/oauth/bitbucket/callback

# Jira auth: use either JIRA_EMAIL + JIRA_API_TOKEN, or JIRA_PAT / JIRA_TOKEN.
JIRA_BASE_URL=https://jira.getinsured.com
JIRA_EMAIL=team@example.com
JIRA_API_TOKEN=replace_with_jira_api_token
JIRA_PAT=replace_with_jira_personal_access_token
JIRA_TOKEN=replace_with_jira_token
JIRA_PROJECT_KEY=PROJECT
