NODE_ENV=development
APP_ENV=local
PORT=8787
STORAGE_DIR=./storage
BUNDLES_DIR=./storage/bundles
FORMATTED_OUTPUT_DIR=./storage/formatted
ENABLE_DEVELOPER_FLOW=false
DEVELOPER_REPO_PATH=
DEVELOPER_SKILL_PATH=
DEVELOPER_SPA_RELATIVE_PATH=ghix-web/src/main/webapp/resources/spa
CURSOR_AGENT_BIN=cursor-agent
CURSOR_RUN_TIMEOUT_MS=1200000

DB_HOST=replace_with_database_host
DB_PORT=5432
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
DB_SCHEMA=public
DB_SSL=false

JIRA_BASE_URL=https://your-jira.example.com
JIRA_EMAIL=team@example.com
JIRA_API_TOKEN=replace_with_jira_api_token
JIRA_PROJECT_KEY=PROJECT
